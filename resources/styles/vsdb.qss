QWidget {
    color: #172033;
    background: #ffffff;
    font-size: 13px;
}
QMainWindow, QMenuBar, QMenu, QToolBar, QStatusBar { background: #f7f8fb; }
QMenuBar { border-bottom: 1px solid #dfe3ea; }
QMenuBar::item:selected, QMenu::item:selected { background: #e7efff; color: #1558d6; }
QToolBar {
    min-height: 44px;
    spacing: 5px;
    padding: 4px 10px;
    border: none;
    border-bottom: 1px solid #dfe3ea;
}
QToolButton { border: 1px solid transparent; border-radius: 6px; padding: 6px 10px; background: transparent; }
QToolButton:hover { background: #e9edf5; }
QToolButton:pressed { background: #dce5f5; }
QToolButton:disabled { color: #9ca5b5; }
QToolButton#qt_toolbar_ext_button { padding: 2px; }
QLabel#brandLabel { font-size: 17px; font-weight: 700; color: #18243b; }
QLabel#paneTitle { color: #687386; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
QLabel#inspectorName { font-size: 19px; font-weight: 650; }
QLabel#inspectorSubtitle { color: #778195; }
QLineEdit {
    min-height: 28px;
    border: 1px solid #cfd5df;
    border-radius: 7px;
    padding: 2px 9px;
    background: #ffffff;
    selection-background-color: #2f6fed;
}
QLineEdit:focus { border-color: #2f6fed; }
QTreeView, QTableView, QPlainTextEdit {
    border: none;
    background: #ffffff;
    alternate-background-color: #f8f9fc;
    selection-background-color: #dce9ff;
    selection-color: #143e85;
}
QTreeView::item { min-height: 25px; border-radius: 4px; }
QTreeView::item:hover { background: #f0f3f8; }
QHeaderView::section {
    background: #f6f7fa;
    color: #596579;
    border: none;
    border-right: 1px solid #e3e6ec;
    border-bottom: 1px solid #dfe3ea;
    padding: 7px 8px;
    font-weight: 600;
}
QTableView::item { padding: 5px 8px; border-bottom: 1px solid #edf0f4; }
QTabWidget::pane { border: none; border-top: 1px solid #dfe3ea; }
QTabBar::tab { background: #f7f8fb; border: none; border-right: 1px solid #e2e5eb; padding: 8px 14px; min-width: 78px; }
QTabBar::tab:selected { background: #ffffff; color: #1558d6; border-bottom: 2px solid #2f6fed; }
QTabBar::tab:hover:!selected { background: #eef1f6; }
QSplitter::handle { background: #dfe3ea; }
QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical { height: 1px; }
QLabel#resultSummary { color: #697589; background: #f8f9fb; border-top: 1px solid #e4e7ed; padding: 6px 10px; }
QStatusBar { color: #5f6b7d; border-top: 1px solid #dfe3ea; }
QStatusBar QLabel { background: transparent; padding: 1px 8px; }
QLabel#connectionStatus { color: #218653; }
QLabel#statusMetrics { color: #546174; font-weight: 600; }
